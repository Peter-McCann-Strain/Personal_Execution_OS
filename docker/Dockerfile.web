# ─── Stage 1: Frontend builder ────────────────────────────────────────────────
# Builder-only: Node, npm, and frontend dependencies are not copied into the runtime image.
FROM node:22.23.2-alpine3.24@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS builder

WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
ARG VITE_SOURCE_REPOSITORY_URL=""
ENV VITE_SOURCE_REPOSITORY_URL=$VITE_SOURCE_REPOSITORY_URL
RUN npm run build

# ─── Stage 2: Non-root static server + API proxy ──────────────────────────────
FROM nginxinc/nginx-unprivileged:1.31.5-alpine3.24@sha256:aa8c9087d36d93e9d650c5365f883b421e8214aedbad24ade52b844c583358f1

ARG APP_VERSION=0.1.1
ARG SOURCE_REPOSITORY_URL=https://github.com/Peter-McCann-Strain/Personal_Execution_OS
ARG SOURCE_REVISION=local

LABEL org.opencontainers.image.title="Personal Execution OS web" \
      org.opencontainers.image.description="PWA and same-origin proxy for Personal Execution OS" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.source="${SOURCE_REPOSITORY_URL}" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.licenses="Apache-2.0"

COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx-site.conf.template /etc/nginx/templates/execution-os.conf.template
COPY --chmod=0555 docker/web-entrypoint.sh /usr/local/bin/execution-os-web-entrypoint
COPY --from=builder /app/frontend/dist /usr/share/nginx/html

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/execution-os-web-entrypoint"]
CMD ["nginx", "-g", "daemon off;"]
