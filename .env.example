# Personal Execution OS — local configuration template
#
# Copy this file to `.env`, generate the marked local secrets, and keep `.env`
# private. Blank optional values disable their integrations.

# Core
APP_ENV=development
LOG_LEVEL=INFO
USER_TIMEZONE=UTC
PRIVATE_SINGLE_USER_MODE=true
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Optional CLI credential. Browser users authenticate with the first-run
# password flow and secure session cookies.
CHAT_API_KEY=

# LLM provider
# Set LLM_PROVIDER=anthropic and create your own key for model-backed features.
LLM_PROVIDER=disabled
ANTHROPIC_API_KEY=

# Local PostgreSQL + pgvector
DATABASE_URL=postgresql+asyncpg://assistant:assistant_dev@localhost:5432/personal_execution_os
# Compose creates separate bootstrap, migration-owner, and RLS-constrained
# runtime roles. ./scripts/start.sh generates all three values.
POSTGRES_ADMIN_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_PASSWORD=

# Local services
REDIS_URL=redis://localhost:6379/0
# Optional host Ollama for embeddings in the Compose install:
# OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_HOST=
OLLAMA_EMBED_MODEL=nomic-embed-text:v2-moe

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Google Calendar and Gmail (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_OAUTH_REDIRECT_URL=
CONNECTOR_TOKEN_ENCRYPTION_KEY=

# Web research and developer tooling (optional)
TAVILY_API_KEY=
GITHUB_TOKEN=
GITHUB_ISSUE_FILER_ENABLED=false
GITHUB_ISSUE_REPO=

# Browser push (optional)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:owner@example.com

# Observability (optional; disabled by blank endpoints/keys)
SENTRY_DSN=
SENTRY_SEND_DEFAULT_PII=false
POSTHOG_API_KEY=
POSTHOG_HOST=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
HEALTHCHECKS_HEARTBEAT_URL=

# Local web port
APP_PORT=8080
# Optional exact DNS hostname or IPv4 address accepted from an external TLS
# proxy. Do not include a scheme, port, path, wildcard, or comma-separated list.
PUBLIC_HOSTNAME=

# Privacy and automated behavior
PII_REDACTION_ENABLED=true
HITL_ENABLED=true
HITL_AUTO_APPROVE_DESTINATIONS_RAW=
# Opt in only after reviewing provider costs and the scheduled actions created
# by proactive automation.
PROACTIVE_AUTOMATION_ENABLED=false
# Opt in only after reviewing retention and backup policy. Maintenance compacts
# or removes old runtime transcripts, artifacts, and checkpoints.
SESSION_MAINTENANCE_ENABLED=false
AUTO_JUDGE_ENABLED=false
DATASET_CURATION_ENABLED=false
EVAL_PIPELINE_ENABLED=false
EVAL_EXPORT_ENABLED=false
SPOTCHECK_ENABLED=false
COST_ALERTS_ENABLED=false
QUALITY_ALERTS_ENABLED=false
SLO_ALERTS_ENABLED=false
